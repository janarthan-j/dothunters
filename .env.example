# Copy to .env.local and fill in. Never commit real values.
# Gmail account that sends the form emails
GMAIL_USER=you@gmail.com
# 16-char App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=
# Inbox that receives submissions (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=hello@dothunters.com
