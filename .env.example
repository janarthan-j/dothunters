# Copy to .env.local and fill in. Never commit real values.
# Gmail account that sends the form emails
GMAIL_USER=mailtodothunters@gmail.com
# 16-char App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=
# Inbox that receives submissions (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=mailtodothunters@gmail.com
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Leave blank in local dev to skip the check.
# Required in production: without the secret, form submissions are rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
